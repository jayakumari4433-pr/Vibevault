# ───────────────────────────────────────────────────────────
# VibeVault — environment variables
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real keys.
# ───────────────────────────────────────────────────────────

# ── Supabase (database) ──
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key   # server-only, keep secret

# ── Admin panel ──
ADMIN_PASSWORD=vault123                 # the admin login password
ADMIN_SESSION_SECRET=change_me_to_random # any long random string (signs the admin cookie)

# ── Razorpay (payments — optional until you go live) ──
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx

# ── WhatsApp notifications (optional) ──
WHATSAPP_BUSINESS_NUMBER=+91XXXXXXXXXX
WHATSAPP_API_TOKEN=xxxx
